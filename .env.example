# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Prisma
DATABASE_URL=

# App
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=

# CORS
# Comma-separated list of allowed frontend origins
# Add http://localhost when running fintrack-web via Docker
ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# Resend API key — used for sending password reset emails
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=

# Frontend URL — used to build password reset links in emails
FRONTEND_URL=