{
  "name": "fintrack-api",
  "version": "1.0.0",
  "description": "REST API for personal finance tracking built with Node.js, TypeScript, Express and Prisma",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec npx tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts,.js",
    "typecheck": "tsc --noEmit",
    "db:dev": "docker compose -f docker-compose.dev.yml up -d",
    "db:test": "docker compose -f docker-compose.test.yml up -d",
    "db:prod": "docker compose -f docker-compose.prod.yml up -d",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "dotenv -e .env -- prisma studio",
    "db:studio:test": "dotenv -e .env.test -- prisma studio",
    "db:reset": "dotenv -e .env -- prisma migrate reset",
    "db:reset:test": "dotenv -e .env.test -- prisma migrate reset",
    "test": "dotenv -e .env.test -- prisma migrate reset --force && dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest watch",
    "test:coverage": "dotenv -e .env.test -- prisma migrate reset --force && dotenv -e .env.test -- vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "axios": "^1.15.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "express-status-monitor": "^1.3.4",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "resend": "^6.12.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-status-monitor": "^1.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "4.1.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.2.1",
    "nodemon": "^3.1.14",
    "prisma": "^7.7.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.4"
  }
}
