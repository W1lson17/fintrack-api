# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Prisma
DATABASE_URL=

# App
PORT=3000
NODE_ENV=production

# JWT
JWT_SECRET=

# CORS
# Comma-separated list of allowed frontend origins
# Add your production frontend domain
ALLOWED_ORIGINS=http://localhost,https://your-frontend-domain.com

# Resend API key — used for sending password reset emails
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=

# Frontend URL — used to build password reset links in emails
FRONTEND_URL=http://localhost:5173